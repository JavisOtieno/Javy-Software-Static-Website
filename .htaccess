RewriteEngine On
RewriteBase /

# 1. Redirect requests with .php extension to extensionless URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^\s]+)\.php [NC]
RewriteRule ^([^\s]+)\.php$ /$1 [R=301,L]

# 2. Redirect /index or /foo/index to / or /foo/
RewriteRule ^(.*)/?index$ /$1 [R=301,L]

# 3. Remove trailing slash if not a directory
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 4. Internally rewrite extensionless URLs to .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
