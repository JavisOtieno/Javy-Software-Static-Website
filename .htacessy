RewriteEngine On

# Remove .php extension (redirect to extensionless URL)
RewriteCond %{THE_REQUEST} ^GET\ (.*)\.php\ HTTP
RewriteRule (.*)\.php$ $1 [R=301]

# Remove "index" from URLs (e.g., /index or /foo/index to / or /foo/)
RewriteRule (.*)index$ $1 [R=301]

# Remove trailing slash if not a directory
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /$
RewriteRule (.*)/ $1 [R=301]

# Internally add .php back for serving (no browser redirect)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteCond %{REQUEST_URI} !/$
RewriteRule (.*) $1\.php [L]
